# Copy to .env.local and fill in. Never commit real secrets.
# Everything prefixed NEXT_PUBLIC_ is visible in the browser.

# --- Chain: Robinhood Chain mainnet, verified 10 Nov 2026 (see docs/08-CHAIN-VERIFICATION.md) ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
# The public RPC is rate-limited and not for production. Swap in a keyed endpoint (for example Alchemy) before going public.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Contracts ---
# The app switches from demo to live only when BOTH addresses are set. Leave TAPE empty until you deploy.
NEXT_PUBLIC_TAPE_ADDRESS=
# $WIF (World is Flat), verified: 18 decimals
NEXT_PUBLIC_WIF_ADDRESS=0x5173b8eA6923c2d40267890D45C46a3480954773
NEXT_PUBLIC_WIF_DECIMALS=18

# --- Social / voting ---
NEXT_PUBLIC_VOTE_URL=https://worldisflat.fun/build
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI analysts (server-side only; optional. Without a key the analysts use a built-in fallback) ---
ANTHROPIC_API_KEY=

# --- Keeper bot (server-side only; a dedicated throwaway wallet that only pays gas) ---
KEEPER_PRIVATE_KEY=

# --- Testnet demo (see README). Set TEST_FAUCET=true to show the "Get 1,000 tWIF" button ---
# NEXT_PUBLIC_TEST_FAUCET=true
# Bots (server-side only, throwaway testnet wallets written by scripts/testnet-setup.mjs into the git-ignored .env.testnet):
# PUSHER_PRIVATE_KEY=
# FEED_NVDA=
# FEED_TSLA=
# FEED_AAPL=
# SEEDER_0_UP_PRIVATE_KEY=   (and SEEDER_0_DOWN, SEEDER_1_UP/DOWN, SEEDER_2_UP/DOWN)
